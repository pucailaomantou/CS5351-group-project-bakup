{
  "default": {
    "read": false,
    "write": false
  },
  "paths": {
    "AGENTS.md": { "read": true, "write": true, "owner": "A", "human_approval": "always" },
    "Prompt.md": { "read": true, "write": true, "owner": "A", "human_approval": "always" },
    "README.md": { "read": true, "write": true, "owner": "A", "human_approval": "always" },
    ".opencode/": {
      "read": true,
      "write": true,
      "owner": "A",
      "human_approval": "always",
      "note": "Human-owned: an agent may never edit its own constraints."
    },
    ".agent/": {
      "read": true,
      "write": true,
      "owner": "A",
      "human_approval": "always",
      "note": "Project covenant. Human-owned."
    },
    ".github/": { "read": true, "write": true, "owner": "A" },
    ".github/workflows/": { "read": true, "write": true, "owner": "E" },

    "docs/req/": {
      "read": true,
      "write": false,
      "owner": "B",
      "human_approval": "always",
      "note": "Requirement registry. Frozen ids and criteria; only humans modify requirements."
    },
    "docs/architecture/": {
      "read": true,
      "write": true,
      "owner": "B",
      "note": "ADRs and the architecture blueprint."
    },

    "src/tradingagents/graph/": { "read": true, "write": true, "owner": "C" },
    "src/tradingagents/graph/setup.py": {
      "read": true,
      "write": false,
      "owner": "C",
      "human_approval": "always",
      "note": "Graph wiring. D reports the needed change to C; D never edits it."
    },
    "src/tradingagents/agents/researchers/": { "read": true, "write": true, "owner": "C" },
    "src/tradingagents/agents/managers/": { "read": true, "write": true, "owner": "C" },
    "src/tradingagents/agents/analysts/": { "read": true, "write": true, "owner": "C" },
    "src/tradingagents/default_config.py": {
      "read": true,
      "write": false,
      "owner": "C",
      "human_approval": "always",
      "note": "Holds the frozen COST-01 levers 8 / 8 / 3."
    },
    "src/cli/stats_handler.py": { "read": true, "write": true, "owner": "C" },
    "src/tradingagents/reporting.py": { "read": true, "write": true, "owner": "C" },

    "src/tradingagents/safety/": {
      "read": true,
      "write": false,
      "owner": "D",
      "human_approval": "always",
      "note": "The safety guard. Plain code only, zero LLM calls. New location, not yet created."
    },
    "src/tradingagents/agents/rating.py": { "read": true, "write": true, "owner": "D" },
    "src/tradingagents/agents/schemas.py": { "read": true, "write": true, "owner": "D" },
    "src/tradingagents/agents/post_screen.py": { "read": true, "write": true, "owner": "D" },

    "test/": { "read": true, "write": true, "owner": "E" },
    "test/offline/": {
      "read": true,
      "write": false,
      "owner": "E",
      "human_approval": "always",
      "note": "The regression oracle. Never weakened, skipped or deleted to pass."
    },
    "Report.md": {
      "read": true,
      "write": true,
      "owner": "E",
      "note": "Planned release report; not yet in the repository."
    },

    "BASELINE.md": {
      "read": true,
      "write": false,
      "owner": "frozen",
      "note": "FROZEN for everyone. Provenance anchor for the vendored baseline."
    },
    "transcripts/": {
      "read": true,
      "write": false,
      "owner": "frozen",
      "note": "FROZEN for everyone. Meeting and session records."
    },
    "docs/upstream/": {
      "read": true,
      "write": false,
      "owner": "frozen",
      "note": "FROZEN for everyone. Upstream README, as retrieved."
    }
  },
  "guard_rules": {
    "safety_guard_is_plain_code": {
      "description": "Nothing under src/tradingagents/safety/ may call an LLM. The guard is deterministic.",
      "enforcement": "review",
      "action": "block_merge"
    },
    "review_is_not_tradeable": {
      "description": "final_rating REVIEW must never become a tradeable position.",
      "enforcement": "ci_gate",
      "action": "block_merge"
    },
    "cost_levers_are_frozen": {
      "description": "max_tool_rounds 8, news_article_limit 8, three global news queries. Changing them is not a fix.",
      "enforcement": "ci_gate",
      "action": "block_merge"
    },
    "vendored_package_boundary": {
      "description": "Third-party vendor imports only under src/tradingagents/dataflows/.",
      "enforcement": "ci_gate",
      "action": "block_merge"
    }
  },
  "enforcement": {
    "mechanism": "pre-commit hook for writes, CI gates for boundary and regression checks",
    "ci_gate": "CI runs Schema, Offline Test and Static Analysis gates on every PR; branch protection is not yet enforced."
  }
}
